{
  "schema_version": "1.0",
  "project": "HANFIS Cybersecurity Dynamic Risk Assessment",
  "data_stage": "raw_source_data",
  "description": "Schema for raw cybersecurity telemetry collected from Jetson, security scanners, Kubernetes, IAM, asset inventory, and threat intelligence sources.",
  "join_key": "event_id",
  "row_identity": [
    "event_id",
    "timestamp_utc",
    "asset_id"
  ],
  "fields": {
    "event_id": {
      "type": "string",
      "required": true,
      "unique": true,
      "description": "Unique identifier for each cybersecurity event"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "required": true,
      "description": "Event timestamp in UTC using ISO 8601 format"
    },
    "asset_id": {
      "type": "string",
      "required": true,
      "description": "Pseudonymous identifier of the monitored asset"
    },
    "cvss": {
      "type": "float",
      "minimum": 0.0,
      "maximum": 10.0,
      "required": true,
      "risk_direction": "higher_is_riskier"
    },
    "exploitability": {
      "type": "float",
      "minimum": 0.0,
      "maximum": 10.0,
      "required": true,
      "risk_direction": "higher_is_riskier"
    },
    "patch_risk": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "required": true,
      "categories": {
        "0": "Patched",
        "1": "Patch available but not applied",
        "2": "No patch or critically overdue"
      },
      "risk_direction": "higher_is_riskier"
    },
    "mfa_risk": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "required": true,
      "categories": {
        "0": "Strong MFA or FIDO2",
        "1": "Weak or limited MFA",
        "2": "No MFA"
      },
      "risk_direction": "higher_is_riskier"
    },
    "kubernetes_exposure": {
      "type": "float",
      "minimum": 0.0,
      "maximum": 10.0,
      "required": true,
      "risk_direction": "higher_is_riskier"
    },
    "asset_criticality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "required": true,
      "risk_direction": "higher_is_riskier"
    },
    "threat_intelligence": {
      "type": "float",
      "minimum": 0.0,
      "maximum": 1.0,
      "required": true,
      "risk_direction": "higher_is_riskier"
    }
  },
  "normalization_rules": {
    "cvss": "value / 10.0",
    "exploitability": "value / 10.0",
    "patch_risk": "value / 2.0",
    "mfa_risk": "value / 2.0",
    "kubernetes_exposure": "value / 10.0",
    "asset_criticality": "(value - 1.0) / 4.0",
    "threat_intelligence": "value"
  },
  "quality_rules": {
    "missing_values_allowed": false,
    "event_id_must_be_unique": true,
    "timestamp_timezone": "UTC",
    "normalized_values_must_be_between": [
      0.0,
      1.0
    ]
  }
}